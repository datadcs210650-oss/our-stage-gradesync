rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function anonymousUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function emailUser() {
      return signedIn() && !anonymousUser();
    }

    // ================= ADMIN SESSION =================
    function adminSessionPath() {
      return /databases/$(database)/documents/admin_sessions/$(request.auth.uid);
    }

    function validAdminProfile(profileId) {
      let p = /databases/$(database)/documents/users/$(profileId);
      return exists(p)
        && get(p).data.role in ['Admin', 'SuperAdmin']
        && get(p).data.get('status', 'Active') != 'Inactive'
        && get(p).data.get('email', request.auth.token.email) == request.auth.token.email;
    }

    function validAdminSessionPayload(uid) {
      return emailUser()
        && request.auth.uid == uid
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.profileId is string
        && request.resource.data.email == request.auth.token.email
        && validAdminProfile(request.resource.data.profileId);
    }

    function isAdminSession() {
      return emailUser()
        && exists(adminSessionPath())
        && get(adminSessionPath()).data.authUid == request.auth.uid
        && get(adminSessionPath()).data.profileId is string
        && validAdminProfile(get(adminSessionPath()).data.profileId);
    }

    // ================= GRADER SESSION =================
    function sessionPath() {
      return /databases/$(database)/documents/grader_sessions/$(request.auth.uid);
    }

    function hasGraderSession() {
      return anonymousUser() && exists(sessionPath());
    }

    function graderUserPath() {
      return /databases/$(database)/documents/users/$(get(sessionPath()).data.userId);
    }

    function graderAssignedGroup(groupId) {
      return hasGraderSession()
        && exists(graderUserPath())
        && get(graderUserPath()).data.role == 'Grader'
        && get(graderUserPath()).data.get('status', 'Active') != 'Inactive'
        && get(sessionPath()).data.graderCode == get(graderUserPath()).data.code
        && groupId in get(graderUserPath()).data.assignedGroups;
    }

    function manualGroupOpen(groupId) {
      let gPath = /databases/$(database)/documents/competition_groups/$(groupId);
      return exists(gPath)
        && get(gPath).data.openMode != 'auto'
        && (
          get(gPath).data.get('isManuallyOpened', false) == true
          || get(gPath).data.get('isPublished', false) == true
        )
        && (
          get(gPath).data.get('closeAt', null) == null
          || !(get(gPath).data.get('closeAt', null) is timestamp)
          || request.time <= get(gPath).data.closeAt
        );
    }

    function autoGroupOpen(groupId) {
      let gPath = /databases/$(database)/documents/competition_groups/$(groupId);
      let pPath = /databases/$(database)/documents/group_publication_index/$(groupId);
      return exists(gPath)
        && get(gPath).data.openMode == 'auto'
        && (
          (
            get(gPath).data.get('openAt', null) is timestamp
            && request.time >= get(gPath).data.openAt
            && (
              get(gPath).data.get('closeAt', null) == null
              || !(get(gPath).data.get('closeAt', null) is timestamp)
              || request.time <= get(gPath).data.closeAt
            )
          )
          ||
          (
            get(gPath).data.get('publishAt', null) is timestamp
            && request.time >= get(gPath).data.publishAt
            && (
              get(gPath).data.get('publishUntil', null) == null
              || !(get(gPath).data.get('publishUntil', null) is timestamp)
              || request.time <= get(gPath).data.publishUntil
            )
          )
          ||
          (
            exists(pPath)
            && get(pPath).data.get('openAt', null) is timestamp
            && request.time >= get(pPath).data.openAt
            && (
              get(pPath).data.get('closeAt', null) == null
              || !(get(pPath).data.get('closeAt', null) is timestamp)
              || request.time <= get(pPath).data.closeAt
            )
          )
        );
    }

    function groupIsOpen(groupId) {
      return manualGroupOpen(groupId) || autoGroupOpen(groupId);
    }

    function graderCanGradeGroup(groupId) {
      return graderAssignedGroup(groupId) && groupIsOpen(groupId);
    }

    function currentGraderCode() {
      return get(sessionPath()).data.graderCode;
    }

    function gradingNotVerified(groupId, graderCode) {
      let vid = graderCode + '_' + groupId;
      return !exists(/databases/$(database)/documents/grader_verifications/$(vid))
        || get(/databases/$(database)/documents/grader_verifications/$(vid)).data.get('isVerified', false) != true;
    }

    function candidateMatchesGroup(candidateId, groupId) {
      let cPath = /databases/$(database)/documents/candidates/$(candidateId);
      return exists(cPath) && get(cPath).data.groupId == groupId;
    }

    function validSessionPayload(uid) {
      let userId = request.resource.data.userId;
      let uPath = /databases/$(database)/documents/users/$(userId);
      return anonymousUser()
        && request.auth.uid == uid
        && request.resource.data.authUid == request.auth.uid
        && exists(uPath)
        && get(uPath).data.role == 'Grader'
        && get(uPath).data.get('status', 'Active') != 'Inactive'
        && request.resource.data.graderCode == get(uPath).data.code;
    }

    // Email Auth chỉ được đọc users để tìm hồ sơ đăng nhập Admin.
    // Mọi quyền quản trị khác bắt buộc phải có admin_sessions hợp lệ.
    match /users/{userId} {
      allow read: if emailUser() || (anonymousUser() && resource.data.role == 'Grader');
      allow create, update, delete: if isAdminSession();
    }

    match /admin_sessions/{uid} {
      allow read: if emailUser() && request.auth.uid == uid;
      allow create, update: if validAdminSessionPayload(uid);
      allow delete: if emailUser() && request.auth.uid == uid;
    }

    match /grader_sessions/{uid} {
      allow read: if isAdminSession() || (anonymousUser() && request.auth.uid == uid);
      allow create, update: if validSessionPayload(uid) || isAdminSession();
      allow delete: if isAdminSession() || (anonymousUser() && request.auth.uid == uid);
    }

    match /competition_groups/{groupId} {
      allow read: if isAdminSession() || (anonymousUser() && graderAssignedGroup(groupId));
      allow create, update, delete: if isAdminSession();
    }

    match /group_publication_index/{groupId} {
      allow read: if isAdminSession() || (anonymousUser() && graderAssignedGroup(groupId));
      allow create, update, delete: if isAdminSession();
    }

    match /candidates/{candidateId} {
      allow read: if isAdminSession()
        || (
          anonymousUser()
          && resource.data.groupId is string
          && graderCanGradeGroup(resource.data.groupId)
        );
      allow create, update, delete: if isAdminSession();
    }

    match /scores/{scoreId} {
      allow read: if isAdminSession()
        || (
          anonymousUser()
          && resource.data.groupId is string
          && resource.data.graderCode == currentGraderCode()
          && graderCanGradeGroup(resource.data.groupId)
        );

      allow create: if anonymousUser()
        && request.resource.data.keys().hasOnly([
          'candidateId','groupId','graderCode','graderName','scores','totalScore',
          'revision','schemaVersion','locked','timestamp','updatedAt'
        ])
        && request.resource.data.schemaVersion == 2
        && request.resource.data.revision == 1
        && request.resource.data.candidateId is string
        && request.resource.data.groupId is string
        && request.resource.data.graderCode == currentGraderCode()
        && candidateMatchesGroup(request.resource.data.candidateId, request.resource.data.groupId)
        && graderCanGradeGroup(request.resource.data.groupId)
        && gradingNotVerified(request.resource.data.groupId, request.resource.data.graderCode);

      allow update: if anonymousUser()
        && request.resource.data.keys().hasOnly([
          'candidateId','groupId','graderCode','graderName','scores','totalScore',
          'revision','schemaVersion','locked','timestamp','updatedAt'
        ])
        && request.resource.data.schemaVersion == 2
        && request.resource.data.revision == resource.data.get('revision', 0) + 1
        && request.resource.data.candidateId == resource.data.candidateId
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.graderCode == resource.data.graderCode
        && request.resource.data.graderCode == currentGraderCode()
        && candidateMatchesGroup(request.resource.data.candidateId, request.resource.data.groupId)
        && graderCanGradeGroup(request.resource.data.groupId)
        && gradingNotVerified(request.resource.data.groupId, request.resource.data.graderCode);

      allow delete: if isAdminSession();
    }

    match /grader_verifications/{verificationId} {
      allow read: if isAdminSession()
        || (
          anonymousUser()
          && resource.data.groupId is string
          && resource.data.graderCode == currentGraderCode()
          && graderAssignedGroup(resource.data.groupId)
        );

      allow create: if anonymousUser()
        && request.resource.data.groupId is string
        && request.resource.data.graderCode == currentGraderCode()
        && request.resource.data.isVerified == true
        && graderCanGradeGroup(request.resource.data.groupId);

      allow update: if anonymousUser()
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.graderCode == resource.data.graderCode
        && request.resource.data.graderCode == currentGraderCode()
        && request.resource.data.isVerified == true
        && graderCanGradeGroup(request.resource.data.groupId);

      allow delete: if isAdminSession();
    }

    match /audit_logs/{logId} {
      allow read: if isAdminSession();
      allow create: if anonymousUser()
        && request.resource.data.groupId is string
        && request.resource.data.candidateId is string
        && request.resource.data.graderCode == currentGraderCode()
        && candidateMatchesGroup(request.resource.data.candidateId, request.resource.data.groupId)
        && graderCanGradeGroup(request.resource.data.groupId);
      allow update, delete: if isAdminSession();
    }

    match /submission_notifications/{notificationId} {
      allow read: if isAdminSession();
      allow create: if anonymousUser()
        && request.resource.data.schemaVersion == 2
        && request.resource.data.type == 'GRADING_SUBMITTED'
        && request.resource.data.graderCode == currentGraderCode()
        && request.resource.data.groupId is string
        && graderCanGradeGroup(request.resource.data.groupId);
      allow update, delete: if isAdminSession();
    }

    match /attendance_realtime/{groupId} {
      allow read: if isAdminSession() || (anonymousUser() && graderCanGradeGroup(groupId));
      allow create, update, delete: if isAdminSession();
    }
  }
}
